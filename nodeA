// ================= WIFI =================

const char* AP_NAME = "LoRa-Node-A";
const char* AP_PASSWORD = "12345678";

IPAddress local_IP(192, 168, 10, 1);
IPAddress gateway(192, 168, 10, 1);
IPAddress subnet(255, 255, 255, 0);

// ================= LORA =================

#define LORA_SS    D1
#define LORA_RST   D2
#define LORA_DIO0  D0

ESP8266WebServer server(80);

// ================= ENCRYPTION =================

const String SECRET_KEY = "LoRaSecret2026";

// ================= DATA =================

String lastSent = "No message sent";
String lastSentEncrypted = "No encrypted data";

String lastReceived = "No message received";
String lastReceivedEncrypted = "No encrypted data";

int sentCount = 0;
int receivedCount = 0;
long lastRSSI = 0;

// ================= ENCRYPT =================

String encryptMessage(String text) {

  String result = "";

  for (int i = 0; i < text.length(); i++) {

    byte encryptedByte =
      text[i] ^ SECRET_KEY[i % SECRET_KEY.length()];

    if (encryptedByte < 16) {
      result += "0";
    }

    result += String(encryptedByte, HEX);
  }

  result.toUpperCase();

  return result;
}

// ================= DECRYPT =================

String decryptMessage(String hexText) {

  String result = "";

  for (int i = 0; i < hexText.length(); i += 2) {

    if (i + 1 >= hexText.length()) {
      break;
    }

    String byteString =
      hexText.substring(i, i + 2);

    byte encryptedByte =
      strtol(byteString.c_str(), NULL, 16);

    char originalChar =
      encryptedByte ^
      SECRET_KEY[(i / 2) % SECRET_KEY.length()];

    result += originalChar;
  }

  return result;
}

// ================= JSON ESCAPE =================

String jsonEscape(String text) {

  text.replace("\\", "\\\\");
  text.replace("\"", "\\\"");
  text.replace("\n", "\\n");
  text.replace("\r", "\\r");

  return text;
}

// ================= STATUS =================

void handleStatus() {

  String json = "{";

  json += "\"sent\":\"";
  json += jsonEscape(lastSent);
  json += "\",";

  json += "\"sentEncrypted\":\"";
  json += jsonEscape(lastSentEncrypted);
  json += "\",";

  json += "\"received\":\"";
  json += jsonEscape(lastReceived);
  json += "\",";

  json += "\"receivedEncrypted\":\"";
  json += jsonEscape(lastReceivedEncrypted);
  json += "\",";

  json += "\"sentCount\":";
  json += String(sentCount);
  json += ",";

  json += "\"receivedCount\":";
  json += String(receivedCount);
  json += ",";

  json += "\"rssi\":";
  json += String(lastRSSI);

  json += "}";

  server.send(200, "application/json", json);
}

// ================= SEND =================

void handleSend() {

  if (!server.hasArg("msg")) {

    server.send(
      400,
      "text/plain",
      "Message missing"
    );

    return;
  }

  String message = server.arg("msg");

  if (message.length() == 0) {

    server.send(
      400,
      "text/plain",
      "Empty message"
    );

    return;
  }

  // Encrypt
  String encrypted = encryptMessage(message);

  // Store for webpage
  lastSent = message;
  lastSentEncrypted = encrypted;

  // Send encrypted data through LoRa
  LoRa.idle();

  LoRa.beginPacket();
  LoRa.print(encrypted);
  LoRa.endPacket();

  LoRa.receive();

  sentCount++;

  Serial.println();
  Serial.println("========== TRANSMISSION ==========");
  Serial.print("Original:   ");
  Serial.println(message);

  Serial.print("Encrypted:  ");
  Serial.println(encrypted);

  Serial.println("==================================");

  server.send(
    200,
    "application/json",
    "{\"status\":\"sent\"}"
  );
}

