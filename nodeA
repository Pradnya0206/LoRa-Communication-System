// ================= SETUP =================

void setup() {

  Serial.begin(115200);

  delay(1000);

  WiFi.mode(WIFI_AP);

  WiFi.softAPConfig(
    local_IP,
    gateway,
    subnet
  );

  WiFi.softAP(
    AP_NAME,
    AP_PASSWORD
  );

  Serial.println();
  Serial.println("==============================");
  Serial.println("      LORA NODE A ONLINE");
  Serial.println("==============================");

  Serial.print("WiFi: ");
  Serial.println(AP_NAME);

  Serial.print("IP: ");
  Serial.println(WiFi.softAPIP());

  LoRa.setPins(
    LORA_SS,
    LORA_RST,
    LORA_DIO0
  );

  if(!LoRa.begin(433E6)) {

    Serial.println(
      "LoRa initialization failed!"
    );

    while(true) {
      delay(1000);
    }
  }

  LoRa.setSpreadingFactor(12);

  LoRa.setSignalBandwidth(125E3);

  LoRa.setCodingRate4(5);

  LoRa.setSyncWord(0x12);

  LoRa.receive();

  server.on(
    "/",
    handleRoot
  );

  server.on(
    "/status",
    handleStatus
  );

  server.on(
    "/send",
    handleSend
  );

  server.begin();

  Serial.println(
    "LoRa initialized successfully"
  );

  Serial.println(
    "Web server started"
  );
}

// ================= LOOP =================

void loop() {

  server.handleClient();

  int packetSize =
    LoRa.parsePacket();

  if(packetSize) {

    String encryptedMessage = "";

    while(LoRa.available()) {

      encryptedMessage +=
        (char)LoRa.read();

    }

    lastReceivedEncrypted =
      encryptedMessage;

    lastReceived =
      decryptMessage(
        encryptedMessage
      );

    lastRSSI =
      LoRa.packetRssi();

    receivedCount++;

    Serial.println();
    Serial.println("=========== RECEIVED ===========");

    Serial.print("Encrypted: ");
    Serial.println(
      lastReceivedEncrypted
    );

    Serial.print("Decrypted: ");
    Serial.println(
      lastReceived
    );

    Serial.print("RSSI: ");
    Serial.println(
      lastRSSI
    );

    Serial.println(
      "================================"
    );

    LoRa.receive();
  }
}
